{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@bayar-sdk/core": ["./packages/core/src/index.ts"],
			"@bayar-sdk/midtrans": ["./packages/provider-midtrans/src/index.ts"],
			"@bayar-sdk/xendit": ["./packages/provider-xendit/src/index.ts"],
			"@bayar-sdk/hono": ["./packages/hono/src/index.ts"]
		},
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"types": []
	}
}
