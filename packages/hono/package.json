{
	"name": "@bayar-sdk/hono",
	"version": "0.0.1",
	"description": "Hono middleware for bayar-sdk — expose PaymentProvider instances (Midtrans, Xendit) as REST routes for charge, refund, status and webhook.",
	"keywords": [
		"hono",
		"middleware",
		"rest-api",
		"api",
		"payment",
		"payment-gateway",
		"webhook",
		"charge",
		"refund",
		"midtrans",
		"xendit",
		"typescript",
		"bun"
	],
	"homepage": "https://github.com/cakfan/bayar-sdk/blob/main/packages/hono/README.md",
	"bugs": {
		"url": "https://github.com/cakfan/bayar-sdk/issues"
	},
	"author": "cakfan",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/cakfan/bayar-sdk.git"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
		"test": "bun test"
	},
	"dependencies": {
		"@bayar-sdk/core": "^0.0.1"
	},
	"peerDependencies": {
		"hono": "^4.7.0",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"hono": "^4.7.0",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"zod": "^3.24.1"
	}
}
