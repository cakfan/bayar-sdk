{
	"name": "@bayar-sdk/midtrans",
	"version": "0.0.0",
	"description": "Midtrans provider adapter for bayar-sdk",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
		"test": "bun test"
	},
	"dependencies": {
		"@bayar-sdk/core": "^0.0.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	}
}
