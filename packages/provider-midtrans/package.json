{
	"name": "@bayar-sdk/midtrans",
	"version": "0.0.1",
	"description": "Midtrans provider adapter for bayar-sdk — create charges, check status, refund and verify webhooks for Midtrans Core API (bank transfer, virtual account, QRIS, GoPay, e-wallet, credit card).",
	"keywords": [
		"midtrans",
		"veritrans",
		"payment",
		"payment-gateway",
		"sdk",
		"core-api",
		"virtual-account",
		"bank-transfer",
		"qris",
		"gopay",
		"e-wallet",
		"credit-card",
		"indonesia",
		"typescript"
	],
	"homepage": "https://github.com/cakfan/bayar-sdk/blob/main/packages/provider-midtrans/README.md",
	"bugs": {
		"url": "https://github.com/cakfan/bayar-sdk/issues"
	},
	"author": "cakfan",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/cakfan/bayar-sdk.git"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
		"test": "bun test"
	},
	"dependencies": {
		"@bayar-sdk/core": "^0.0.1"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	}
}
