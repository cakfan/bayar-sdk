{
	"name": "@bayar-sdk/core",
	"version": "0.0.1",
	"description": "Core contract, types, errors and provider contract tests for bayar-sdk — an unofficial multi-provider payment gateway SDK (TypeScript) for Midtrans & Xendit.",
	"keywords": [
		"payment",
		"payment-gateway",
		"payment-sdk",
		"sdk",
		"midtrans",
		"xendit",
		"charge",
		"refund",
		"webhook",
		"virtual-account",
		"qris",
		"e-wallet",
		"typescript"
	],
	"homepage": "https://github.com/cakfan/bayar-sdk/blob/main/packages/core/README.md",
	"bugs": {
		"url": "https://github.com/cakfan/bayar-sdk/issues"
	},
	"author": "cakfan",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/cakfan/bayar-sdk.git"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./testing": {
			"import": {
				"types": "./dist/testing/index.d.ts",
				"default": "./dist/testing/index.js"
			},
			"require": {
				"types": "./dist/testing/index.d.cts",
				"default": "./dist/testing/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
		"test": "bun test"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	}
}
