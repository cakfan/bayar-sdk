{
	"name": "bayar-sdk",
	"version": "0.0.0",
	"private": true,
	"description": "Unofficial multi-provider TypeScript SDK untuk integrasi payment gateway (Midtrans, Xendit, dst)",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "bun run --filter \"@bayar-sdk/*\" build",
		"test": "bun test --workspaces",
		"lint": "bunx biome check .",
		"format": "bunx biome format --write .",
		"typecheck": "bun run --filter \"@bayar-sdk/*\" typecheck",
		"changeset": "bunx changeset"
	},
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@changesets/cli": "^2.31.1",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	}
}
